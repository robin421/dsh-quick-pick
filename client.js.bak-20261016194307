// dsh-quick-pick — 极简选区插件（client 端）
//
// 目标：不要预览面板、不要地址栏、不要确认步骤。
// 开启开关后，直接在**当前 Web GUI 界面**上点任意元素，
// 元素的定位信息（选择器 / 文字 / 样式 / HTML 片段）立即写入对话输入框。
//
// 写入通道复用宿主官方 API（与 dsh-web-review 相同）：
//   ctx.sessions.scope(sessionId) → scope.get('conversation')
//     → conversation.input.for(scope).setDraft(text)
//
// 加载方式：宿主 __ModuleLoader__（与 visual-edit 等官方插件一致）。

(function () {
	'use strict';

	function initPlugin() {
		// 本插件为纯 DOM 实现，不依赖 React；不调用 require 可减少加载失败面。

		// ── 状态 ──────────────────────────────────────────────
		var SRC = 'dsh-quick-pick';
		var ACTIVE = false;      // 选区开关
		var HOVER = null;        // 当前高亮元素
		var HUD = null;          // 右下角状态条

		// ── 样式注入 ──────────────────────────────────────────
		function injectStyle() {
			if (document.getElementById('__dqp_style')) return;
			var st = document.createElement('style');
			st.id = '__dqp_style';
			st.textContent =
				'.__dqp_hover{outline:2px solid #4d6bfe !important;outline-offset:-2px;' +
				'background:rgba(77,107,254,.10) !important;cursor:crosshair !important}' +
				'.__dqp_active,.__dqp_active *{cursor:crosshair !important}' +
				'#__dqp_hud{position:fixed;right:14px;bottom:14px;z-index:2147483647;' +
				'font:12px/1.5 -apple-system,system-ui,sans-serif;background:#1c1c1e;color:#fff;' +
				'border-radius:10px;padding:9px 13px;box-shadow:0 6px 22px rgba(0,0,0,.35);' +
				'display:flex;align-items:center;gap:9px;user-select:none}' +
				'#__dqp_hud b{color:#8fa5ff}' +
				'#__dqp_hud .dot{width:8px;height:8px;border-radius:50%;background:#555;flex:none}' +
				'#__dqp_hud.on .dot{background:#4ade80;box-shadow:0 0 8px #4ade80}' +
				'@keyframes __dqp_flash{0%{outline-color:#4ade80}100%{outline-color:#4d6bfe}}' +
				'.__dqp_flash{animation:__dqp_flash .5s ease-out}';
			(document.head || document.documentElement).appendChild(st);
		}

		// ── 元素描述：生成给 AI 的定位信息 ─────────────────────
		function cssPath(el) {
			if (!el || el.nodeType !== 1) return '';
			var parts = [];
			var n = el;
			while (n && n.nodeType === 1 && n !== document.documentElement) {
				var seg = n.tagName.toLowerCase();
				if (n.id) { parts.unshift('#' + n.id); break; }
				var i = 1, sib = n;
				while ((sib = sib.previousElementSibling)) { if (sib.tagName === n.tagName) i++; }
				if (i > 1 || n.nextElementSibling) seg += ':nth-of-type(' + i + ')';
				parts.unshift(seg);
				n = n.parentElement;
			}
			if (n && n.nodeType === 1 && parts[0] && parts[0].charAt(0) !== '#') {
				parts.unshift(n.tagName.toLowerCase());
			}
			return parts.join(' > ');
		}

		function describe(el) {
			if (!el || el.nodeType !== 1) return null;
			var cs = null;
			try { cs = getComputedStyle(el); } catch (e) {}
			var rect = null;
			try { rect = el.getBoundingClientRect(); } catch (e) {}

			// 关键样式：只取有用的少数项，避免刷屏
			var style = {};
			if (cs) {
				['display', 'position', 'width', 'height', 'color', 'backgroundColor',
				 'fontSize', 'fontWeight', 'fontFamily', 'lineHeight', 'padding',
				 'margin', 'border', 'borderRadius', 'textAlign', 'flexDirection',
				 'justifyContent', 'alignItems', 'gap', 'opacity'].forEach(function (k) {
					var v = cs[k];
					if (v && v !== 'normal' && v !== 'none' && v !== 'auto' &&
						v !== 'rgba(0, 0, 0, 0)' && v !== '0px') style[k] = v;
				});
			}

			var html = el.outerHTML || '';
			if (html.length > 3000) html = html.slice(0, 3000) + '\n…(已截断)';

			return {
				tag: el.tagName ? el.tagName.toLowerCase() : '',
				id: el.id || '',
				classes: Array.prototype.slice.call(el.classList || []),
				selector: cssPath(el),
				text: (el.innerText || el.textContent || '').trim().slice(0, 800),
				html: html,
				style: style,
				rect: rect ? { x: Math.round(rect.x), y: Math.round(rect.y), w: Math.round(rect.width), h: Math.round(rect.height) } : null,
				url: location.href
			};
		}

		// ── 写入输入框 ────────────────────────────────────────
		function buildDraft(info) {
			var L = [];
			L.push('【选中的页面元素】');
			L.push('页面: ' + info.url);
			L.push('选择器: ' + info.selector);
			L.push('标签: <' + info.tag + '>' + (info.id ? '  id="' + info.id + '"' : '') +
				(info.classes.length ? '  class="' + info.classes.join(' ') + '"' : ''));
			if (info.text) L.push('文字: ' + info.text.replace(/\n+/g, ' ').slice(0, 400));
			if (info.rect) L.push('位置尺寸: ' + info.rect.w + '×' + info.rect.h + ' @ (' + info.rect.x + ',' + info.rect.y + ')');

			var sks = Object.keys(info.style || {});
			if (sks.length) {
				L.push('关键样式:');
				sks.forEach(function (k) { L.push('  ' + k + ': ' + info.style[k]); });
			}
			L.push('HTML:');
			L.push('```html');
			L.push(info.html);
			L.push('```');
			L.push('');
			L.push('请修改这个元素：');
			return L.join('\n');
		}

		function writeDraft(ctx, text) {
			// 依次尝试几条通道，任一成功即可（不同 DSH 版本 API 略有差异）
			var errs = [];
			try {
				var sessions = ctx.get ? ctx.get('sessions') : ctx.sessions;
				if (sessions) {
					// 通道 1：当前会话 → conversation.input.setDraft
					try {
						var snap = sessions.list ? sessions.list.getSnapshot() : null;
						var cur = snap && snap.current;
						if (cur) {
							var scope = sessions.scope(cur);
							if (scope) {
								var conv = scope.get ? scope.get('conversation') : null;
								if (conv && conv.input) {
									conv.input.for(scope).setDraft(text);
									return true;
								}
							}
						}
					} catch (e1) { errs.push('conversation: ' + e1); }
				} else errs.push('sessions 服务不可用');
			} catch (e) { errs.push('outer: ' + e); }

			// 兜底：直接操作 DOM 里的输入框（textarea / contenteditable）
			try {
				var ta = document.querySelector('textarea');
				if (ta) {
					var setter = Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype, 'value').set;
					setter.call(ta, text);
					ta.dispatchEvent(new Event('input', { bubbles: true }));
					return true;
				}
				var ce = document.querySelector('[contenteditable="true"]');
				if (ce) {
					ce.focus();
					ce.textContent = text;
					ce.dispatchEvent(new Event('input', { bubbles: true }));
					return true;
				}
				errs.push('未找到输入框元素');
			} catch (e2) { errs.push('dom: ' + e2); }

			console.warn('[dsh-quick-pick] 写入失败:', errs.join(' | '));
			return false;
		}

		// ── 事件 ──────────────────────────────────────────────
		function onOver(e) {
			if (!ACTIVE) return;
			var t = e.target;
			if (!t || t.nodeType !== 1) return;
			if (t === HUD || (HUD && HUD.contains(t))) return;
			if (t === HOVER) return;
			if (HOVER) HOVER.classList.remove('__dqp_hover');
			HOVER = t;
			HOVER.classList.add('__dqp_hover');
		}

		function onOut(e) {
			if (HOVER && HOVER === e.target) {
				HOVER.classList.remove('__dqp_hover');
				HOVER = null;
			}
		}

		function stop(e) { e.preventDefault(); e.stopPropagation(); return false; }

		function onKey(e) {
			if (e.key === 'Escape' && ACTIVE) { setActive(false); }
		}

		// ── HUD 状态条 ────────────────────────────────────────
		function makeHud() {
			if (HUD) return HUD;
			var d = document.createElement('div');
			d.id = '__dqp_hud';
			d.innerHTML = '<span class="dot"></span><span>选区批注：<b>关</b>　点击开启</span>';
			d.title = '开启后在当前界面上点任意元素，定位信息会写入输入框（Esc 退出）';
			d.addEventListener('click', function (e) { e.stopPropagation(); setActive(!ACTIVE); });
			// 阻止冒泡，避免点 HUD 被当成选区
			['mousedown', 'mouseup', 'click', 'mouseover'].forEach(function (ev) {
				d.addEventListener(ev, function (e) { e.stopPropagation(); }, true);
			});
			(document.body || document.documentElement).appendChild(d);
			HUD = d;
			return d;
		}

		function setActive(on) {
			ACTIVE = !!on;
			injectStyle();
			var hud = makeHud();
			hud.classList.toggle('on', ACTIVE);
			hud.querySelector('span:last-child').innerHTML = ACTIVE
				? '选区批注：<b>开</b>　点元素即可写入输入框'
				: '选区批注：<b>关</b>　点击开启';
			document.documentElement.classList.toggle('__dqp_active', ACTIVE);

			if (ACTIVE) {
				document.addEventListener('mouseover', onOver, true);
				document.addEventListener('mouseout', onOut, true);
				document.addEventListener('click', onClickCapture, true);
			} else {
				document.removeEventListener('mouseover', onOver, true);
				document.removeEventListener('mouseout', onOut, true);
				document.removeEventListener('click', onClickCapture, true);
				if (HOVER) { HOVER.classList.remove('__dqp_hover'); HOVER = null; }
			}
			// 记忆开关状态
			try { sessionStorage.setItem('dsh-quick-pick:on', ACTIVE ? '1' : '0'); } catch (e) {}
		}

		var CTX = null;

		function onClickCapture(e) {
			if (!ACTIVE) return;
			var t = e.target;
			if (!t || t.nodeType !== 1) return;
			if (t === HUD || (HUD && HUD.contains(t))) return;

			stop(e);
			if (HOVER) { HOVER.classList.remove('__dqp_hover'); HOVER = null; }

			var info = describe(t);
			if (!info) return;

			var ok = writeDraft(CTX, buildDraft(info));

			// 反馈
			t.classList.add('__dqp_flash');
			setTimeout(function () { t.classList.remove('__dqp_flash'); }, 600);

			if (HUD) {
				var label = HUD.querySelector('span:last-child');
				var msg = ok ? '✓ 已写入输入框：' + info.selector.slice(0, 40)
					: '✗ 写入失败，请查看控制台';
				label.innerHTML = msg;
				setTimeout(function () {
					if (ACTIVE) label.innerHTML = '选区批注：<b>开</b>　点元素即可写入输入框';
				}, 2600);
			}

			// 选完自动退出，避免误点
			setTimeout(function () { setActive(false); }, 120);
		}

		// ── 入口：悬停工具栏 + 全局快捷键 ──────────────────────
		function setupShortcut() {
			document.addEventListener('keydown', function (e) {
				// Ctrl/⌘ + Shift + E
				if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'E' || e.key === 'e')) {
					e.preventDefault();
					setActive(!ACTIVE);
				}
			}, true);
		}

		return {
			name: 'dsh-quick-pick',
			// cordis 的服务依赖：声明后 ctx.get('sessions') 才可读。
			// 不声明也能用可选读取，但声明后宿主会等服务就绪再调用 apply，
			// 避免"插件先于服务加载导致拿不到"的时序问题。
			inject: ['sessions'],
			apply: function (ctx) {
				CTX = ctx;
				injectStyle();
				var boot = function () {
					if (!document.body) { setTimeout(boot, 200); return; }
					makeHud();
					setupShortcut();
					// 恢复上次开关（默认关，避免用户误点）
					try {
						if (sessionStorage.getItem('dsh-quick-pick:on') === '1') setActive(true);
					} catch (e) {}
					console.info('[dsh-quick-pick] ready — 点右下角开启，或按 ⌘/Ctrl+Shift+E');
				};
				boot();
			}
		};
	}

	// ── 双模式加载 ────────────────────────────────────────────
	if (typeof window.__ModuleLoader__ !== 'undefined' &&
		typeof window.__ModuleLoader__.load === 'function') {
		window.__ModuleLoader__.load({
			id: 'dsh-quick-pick',
			factory: initPlugin
		});
	} else {
		// 降级：直接执行（宿主插件系统不可用时）
		var plugin = initPlugin();
		if (plugin && typeof plugin.apply === 'function') {
			try {
				plugin.apply({
					get: function () { return undefined; },
					effect: function (fn) { try { fn(); } catch (e) {} }
				});
			} catch (e) { console.warn('[dsh-quick-pick] fallback apply failed:', e); }
		}
		console.info('[dsh-quick-pick] fallback mode');
	}
})();
