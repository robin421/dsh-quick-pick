{
  "name": "dsh-quick-pick",
  "version": "1.0.0",
  "description": "极简选区插件：在当前 Web GUI 界面上点选任意元素，元素的定位信息（选择器 / 文字 / 样式 / HTML 片段）直接写入对话输入框。无预览面板、无地址栏、无确认步骤。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
