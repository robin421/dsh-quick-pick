{
  "name": "dsh-quick-pick",
  "version": "1.3.7",
  "description": "DeepSeek Harness 网页选区插件：在右侧预览区（文件预览 / 内置浏览器）的工具栏上点「选区 (XPath)」，直接在网页上点选元素，Full XPath 自动写入会话输入框。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "Robin <https://blog.wattflow.net>",
  "homepage": "https://blog.wattflow.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robin421/dsh-quick-pick.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "xpath",
    "element-picker",
    "web-preview"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
