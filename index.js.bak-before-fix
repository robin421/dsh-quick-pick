// dsh-quick-pick — 极简选区插件（host 端）
//
// 背景：DSH 的「网页预览」把目标页面渲染在沙箱 iframe / canvas 里，
// 外层 JS 拿不到页面内的 DOM（同源策略 + CDP 流式渲染），所以纯前端
// 的选区方案对"网页内容"必然失效。
//
// 本插件的做法：自己启动一个带 CDP 调试端口的无头 Chrome，
// 通过 CDP 直接在真实页面里执行 Runtime.evaluate 取元素信息。
// 这样无论目标页面怎么渲染，选区都能拿到真实 DOM。
//
// 路由：
//   POST /quick-pick/launch   { url }              → 打开页面，返回 sessionId
//   POST /quick-pick/element  { sessionId, x, y }  → 取该坐标处的元素
//   GET  /quick-pick/ping                           → 健康检查

import { appendFileSync, mkdirSync, rmSync, mkdtempSync, existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { homedir, tmpdir } from 'node:os';
import { spawn } from 'node:child_process';

const LOG_DIR = join(process.env.DSH_HOME || join(homedir(), '.dsh'), 'logs');
const LOG_FILE = join(LOG_DIR, 'quick-pick.log');

function log(msg) {
	try {
		mkdirSync(LOG_DIR, { recursive: true });
		appendFileSync(LOG_FILE, new Date().toISOString() + ' ' + msg + '\n');
	} catch {}
}

log('--- host module evaluated ---');

// ── 浏览器可执行文件探测 ────────────────────────────────────
const CANDIDATES = [
	process.env.QUICK_PICK_BROWSER,
	'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
	'/Applications/Chromium.app/Contents/MacOS/Chromium',
	'/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge',
	'/usr/bin/google-chrome',
	'/usr/bin/chromium',
	'/usr/bin/chromium-browser',
	'/usr/bin/microsoft-edge',
].filter((p) => typeof p === 'string' && p !== '');

function findExecutable() {
	for (const c of CANDIDATES) {
		try { if (existsSync(c)) return c; } catch {}
	}
	return null;
}

// ── 页面内执行的取元素脚本 ──────────────────────────────────
const PICK_JS = String.raw`(() => {
	const el = document.elementFromPoint(__X__, __Y__);
	if (!el) return null;
	function path(e){
		if(!e||e.nodeType!==1) return "";
		const parts=[];let n=e;
		while(n&&n.nodeType===1&&n!==document.documentElement){
			let seg=n.tagName.toLowerCase();
			if(n.id){parts.unshift("#"+n.id);break}
			let i=1,sib=n;
			while((sib=sib.previousElementSibling)){if(sib.tagName===n.tagName)i++}
			if(i>1||n.nextElementSibling)seg+=":nth-of-type("+i+")";
			parts.unshift(seg);n=n.parentElement;
		}
		if(n&&n.nodeType===1&&parts[0]&&parts[0].charAt(0)!=="#")parts.unshift(n.tagName.toLowerCase());
		return parts.join(" > ");
	}
	const cs=getComputedStyle(el);
	const r=el.getBoundingClientRect();
	const keys=["display","position","width","height","color","backgroundColor","fontSize","fontWeight","fontFamily","lineHeight","padding","margin","border","borderRadius","textAlign","flexDirection","justifyContent","alignItems","gap","opacity"];
	const style={};
	for(const k of keys){
		const v=cs[k];
		if(v&&v!=="normal"&&v!=="none"&&v!=="auto"&&v!=="rgba(0, 0, 0, 0)"&&v!=="0px") style[k]=v;
	}
	let html=el.outerHTML||"";
	if(html.length>3000) html=html.slice(0,3000)+"\n...(truncated)";
	return {
		tag: el.tagName?el.tagName.toLowerCase():"",
		id: el.id||"",
		classes: Array.from(el.classList||[]),
		selector: path(el),
		text: (el.innerText||el.textContent||"").trim().slice(0,800),
		html, style,
		rect:{x:Math.round(r.x),y:Math.round(r.y),w:Math.round(r.width),h:Math.round(r.height)},
		url: location.href
	};
})()`;

class CdpSession {
	constructor(ws) {
		this.ws = ws;
		this.nextId = 1;
		this.pending = new Map();
		ws.addEventListener('message', (ev) => {
			let msg;
			try { msg = JSON.parse(ev.data); } catch { return; }
			const p = this.pending.get(msg.id);
			if (!p) return;
			this.pending.delete(msg.id);
			if (msg.error) p.reject(new Error(msg.error.message || 'cdp error'));
			else p.resolve(msg.result);
		});
	}

	send(method, params = {}) {
		const id = this.nextId++;
		return new Promise((resolve, reject) => {
			this.pending.set(id, { resolve, reject });
			try { this.ws.send(JSON.stringify({ id, method, params })); } catch (e) { this.pending.delete(id); reject(e); return; }
			setTimeout(() => {
				if (this.pending.has(id)) {
					this.pending.delete(id);
					reject(new Error('cdp timeout: ' + method));
				}
			}, 15000);
		});
	}

	async evaluate(expression) {
		const r = await this.send('Runtime.evaluate', {
			expression, returnByValue: true, awaitPromise: false,
		});
		if (r && r.exceptionDetails) {
			throw new Error((r.exceptionDetails.exception && r.exceptionDetails.exception.description) || 'evaluate threw');
		}
		return r && r.result ? r.result.value : undefined;
	}
}

class BrowserHandle {
	constructor(exe, profileDir) {
		this.exe = exe; this.profileDir = profileDir;
		this.child = null; this.port = 0;
		this.sessions = new Map();
	}

	static async launch(exe) {
		const profileDir = mkdtempSync(join(tmpdir(), 'quick-pick-'));
		const child = spawn(exe, [
			'--headless=new',
			'--remote-debugging-port=0',
			`--user-data-dir=${profileDir}`,
			'--no-first-run',
			'--no-default-browser-check',
			'--disable-gpu',
			'--disable-features=Translate,MediaRouter',
			'--window-size=1440,900',
			'about:blank',
		], { stdio: ['ignore', 'ignore', 'pipe'] });

		const portFile = join(profileDir, 'DevToolsActivePort');
		const deadline = Date.now() + 20000;
		let port = 0;
		while (Date.now() < deadline) {
			if (child.exitCode !== null) throw new Error('browser exited early: ' + child.exitCode);
			try {
				const first = readFileSync(portFile, 'utf8').split('\n')[0];
				port = Number(first);
				if (Number.isFinite(port) && port > 0) break;
			} catch {}
			await new Promise((r) => setTimeout(r, 120));
		}
		if (port === 0) { child.kill('SIGKILL'); throw new Error('browser never published a debug port'); }

		const h = new BrowserHandle(exe, profileDir);
		h.child = child; h.port = port;
		log('browser launched port=' + port);
		return h;
	}

	async openPage(url) {
		if (!globalThis.WebSocket) throw new Error('运行时没有全局 WebSocket');
		const list = await (await fetch(`http://127.0.0.1:${this.port}/json/list`)).json();
		let target = list.find((t) => t.type === 'page');
		if (!target) {
			target = await (await fetch(`http://127.0.0.1:${this.port}/json/new?about:blank`, { method: 'PUT' })).json();
		}
		const ws = new WebSocket(target.webSocketDebuggerUrl);
		await new Promise((res, rej) => {
			ws.addEventListener('open', res, { once: true });
			ws.addEventListener('error', () => rej(new Error('ws connect failed')), { once: true });
		});
		const s = new CdpSession(ws);
		await s.send('Page.enable');
		await s.send('Runtime.enable');
		await s.send('Page.navigate', { url });
		await new Promise((r) => setTimeout(r, 1400));
		const sid = Math.random().toString(16).slice(2, 10);
		this.sessions.set(sid, s);
		log('page opened ' + url + ' sid=' + sid);
		return sid;
	}

	closeAll() {
		for (const s of this.sessions.values()) { try { s.ws.close(); } catch {} }
		this.sessions.clear();
		if (this.child) { try { this.child.kill('SIGKILL'); } catch {} }
		try { rmSync(this.profileDir, { recursive: true, force: true }); } catch {}
	}
}

export const name = 'dsh-quick-pick';
export const inject = ['webServer'];

let BROWSER = null;

async function getBrowser() {
	if (BROWSER) return BROWSER;
	const exe = findExecutable();
	if (!exe) throw new Error('未找到 Chrome/Chromium/Edge');
	BROWSER = await BrowserHandle.launch(exe);
	return BROWSER;
}

function readJsonBody(req) {
	return new Promise((resolve, reject) => {
		const chunks = [];
		req.on('data', (c) => chunks.push(c));
		req.on('end', () => {
			try {
				const raw = Buffer.concat(chunks).toString('utf8');
				resolve(raw ? JSON.parse(raw) : {});
			} catch (e) { reject(new Error('bad json')); }
		});
		req.on('error', reject);
	});
}

function send(res, code, obj) {
	res.writeHead(code, { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' });
	res.end(JSON.stringify(obj));
}

export function apply(ctx) {
	log('apply() called');
	const webServer = ctx.webServer;

	try {
		ctx.effect(() => webServer.register({
			kind: 'exact', path: '/quick-pick/ping',
			handler: async (req, res) => send(res, 200, { ok: true, plugin: 'dsh-quick-pick', browser: !!BROWSER, exe: findExecutable() })
		}), 'dsh-quick-pick: ping');

		ctx.effect(() => webServer.register({
			kind: 'exact', path: '/quick-pick/launch',
			handler: async (req, res) => {
				try {
					const body = await readJsonBody(req);
					const url = String(body.url || '').trim();
					if (!/^https?:\/\//i.test(url)) return send(res, 400, { ok: false, error: '需要绝对 http(s) 地址' });
					const b = await getBrowser();
					const sid = await b.openPage(url);
					send(res, 200, { ok: true, sessionId: sid });
				} catch (e) {
					log('launch failed: ' + e.message);
					send(res, 500, { ok: false, error: String(e.message || e) });
				}
			}
		}), 'dsh-quick-pick: launch');

		ctx.effect(() => webServer.register({
			kind: 'exact', path: '/quick-pick/element',
			handler: async (req, res) => {
				try {
					const body = await readJsonBody(req);
					const b = await getBrowser();
					const s = b.sessions.get(String(body.sessionId || ''));
					if (!s) return send(res, 404, { ok: false, error: 'session 不存在' });
					const x = Math.max(0, Number(body.x ?? 0));
					const y = Math.max(0, Number(body.y ?? 0));
					const js = PICK_JS.replace('__X__', String(x)).replace('__Y__', String(y));
					const info = await s.evaluate(js);
					send(res, 200, { ok: true, info: info || null });
				} catch (e) {
					log('element failed: ' + e.message);
					send(res, 500, { ok: false, error: String(e.message || e) });
				}
			}
		}), 'dsh-quick-pick: element');

		log('routes registered');
	} catch (e) {
		log('REGISTER FAILED: ' + e.message);
	}

	ctx.on('dispose', () => {
		try { if (BROWSER) BROWSER.closeAll(); } catch {}
		log('disposed');
	});
}
